# syntax=docker/dockerfile:1
#
# Generated by scripts/render.sh from base/spack.yaml and
# base/templates/container/Dockerfile.adcirc. Do not edit by hand.
#
# Targets:
#   devel    compilers, libraries, and build tools
#   runtime  libraries and compiler runtime libraries only
#
FROM {{ build.image }} AS builder

# Optional OCI registry used as a Spack binary cache, e.g.
# oci://ghcr.io/adcirc/spack-buildcache. Packages are pulled from it when
# set, and pushed to it when the buildcache_token secret is also provided.
ARG SPACK_BUILDCACHE=""

# What we want to install and how we want to install it
# is specified in a manifest file (spack.yaml)
RUN mkdir -p {{ paths.environment }} && \
set -o noclobber \
{{ manifest }} > {{ paths.environment }}/spack.yaml

RUN --mount=type=secret,id=buildcache_user,env=SPACK_BUILDCACHE_USER \
    --mount=type=secret,id=buildcache_token,env=SPACK_BUILDCACHE_TOKEN \
    cd {{ paths.environment }} && spack env activate . && \
    if [ -n "${SPACK_BUILDCACHE}" ]; then \
      if [ -n "${SPACK_BUILDCACHE_TOKEN:-}" ]; then \
        spack mirror add --unsigned \
          --oci-username-variable SPACK_BUILDCACHE_USER \
          --oci-password-variable SPACK_BUILDCACHE_TOKEN \
          adcirc-buildcache "${SPACK_BUILDCACHE}"; \
      else \
        spack mirror add --unsigned adcirc-buildcache "${SPACK_BUILDCACHE}"; \
      fi; \
    fi && \
    spack install --fail-fast && \
    if [ -n "${SPACK_BUILDCACHE}" ] && [ -n "${SPACK_BUILDCACHE_TOKEN:-}" ]; then \
      spack buildcache push --update-index adcirc-buildcache; \
    fi && \
    if [ -n "${SPACK_BUILDCACHE}" ]; then spack mirror remove adcirc-buildcache; fi && \
    spack gc -y

# Strip the libraries and executables, except the compilers themselves
RUN find -L {{ paths.view }}/* -type f -exec readlink -f '{}' \; | \
    sort -u | \
    grep -v -e '/intel-oneapi-compilers-' -e '/gcc-[0-9]' | \
    xargs file -i | \
    grep 'charset=binary' | \
    grep 'x-executable\|x-pie-executable\|x-archive\|x-sharedlib' | \
    awk -F: '{print $1}' | xargs -r strip

# Stable locations for the pieces the final images reference directly:
#   /opt/views/oneapi                     oneAPI compiler bin/lib (x86_64 only)
#   {{ paths.environment }}/compiler-runtime.conf  ld.so.conf entry for the
#                                         compiler runtime libraries, so that
#                                         programs built outside of Spack run
#                                         without LD_LIBRARY_PATH
# More than one version of a runtime can be installed (e.g. the one for the
# system compiler that built GCC), so list them all, newest first, so that
# the newest libstdc++/libgfortran take precedence
RUN cd {{ paths.environment }} && spack env activate . && \
    spack find --format '{version} {prefix}' intel-oneapi-runtime gcc-runtime 2>/dev/null | \
      sort -V -r | awk '{print $2 "/lib"}' > compiler-runtime.conf && \
    test -s compiler-runtime.conf && cat compiler-runtime.conf && \
    if spack find intel-oneapi-compilers > /dev/null 2>&1; then \
      ln -s "$(spack location -i intel-oneapi-compilers)/compiler/latest" /opt/views/oneapi; \
    fi && \
    spack env activate --sh -d . > activate.sh

# Remove the compilers, and anything only they needed, for the runtime image
FROM builder AS runtime-builder
RUN cd {{ paths.environment }} && \
    spack -e . find --format '{prefix} /{hash}' intel-oneapi-compilers gcc 2>/dev/null | \
      awk '$1 ~ "^{{ paths.store }}/" {print $2}' | \
      xargs -r spack -e . uninstall -y -f && \
    spack -e . gc -y && \
    spack -e . env view regenerate && \
    rm -f /opt/views/oneapi && \
    spack -e . env activate --sh -d . > activate.sh
{% for flavor in ["runtime", "devel"] %}

FROM {{ run.image }} AS {{ flavor }}

{% set stage = "runtime-builder" if flavor == "runtime" else "builder" %}
COPY --from={{ stage }} {{ paths.environment }} {{ paths.environment }}
COPY --from={{ stage }} {{ paths.store }} {{ paths.store }}
{# paths.view is a symlink, so copy the parent to avoid dereferencing and duplicating it #}
COPY --from={{ stage }} {{ paths.view_parent }} {{ paths.view_parent }}

# The entrypoint also gives users without a writable home directory (for
# example `docker run --user $(id -u):$(id -g)`) a temporary one
RUN { \
      echo '#!/bin/sh' \
      && echo '.' {{ paths.environment }}/activate.sh \
      && echo 'if [ ! -w "${HOME:-/}" ]; then' \
      && echo '  HOME="${TMPDIR:-/tmp}/home-$(id -u)"; export HOME; mkdir -p "${HOME}"' \
      && echo 'fi' \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh \
&& ln -s {{ paths.view }} {{ paths.former_view }} \
&& ln -s {{ paths.environment }}/compiler-runtime.conf /etc/ld.so.conf.d/spack-compiler-runtime.conf \
&& ldconfig

{% if os_packages_final %}
RUN {{ os_packages_final.install }} {{ os_packages_final.list | join | replace('\n', ' ') }}{% if flavor == "devel" %} gcc gcc-c++ git git-lfs make{% endif %} \
 && {{ os_packages_final.clean }}
{% endif %}

# Mirror activate.sh so that commands which bypass the entrypoint
# (e.g. singularity exec, docker run --entrypoint) still work
ENV PATH={{ paths.view }}/bin{% if flavor == "devel" %}:/opt/views/oneapi/bin{% endif %}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
{% if flavor == "devel" %}

# Library locations used by ADCIRC's CMake and CI build commands
ENV NETCDFHOME={{ paths.view }} \
    NETCDF_FORTRAN_HOME={{ paths.view }} \
    HDF5HOME={{ paths.view }} \
    HDF5_ROOT={{ paths.view }} \
    XDMFHOME={{ paths.view }}
{% endif %}

# Default non-root user. The primary group is 0 and the home directory is
# group-writable so the image also works when a platform (e.g. OpenShift)
# assigns an arbitrary UID with GID 0. USER is numeric so that platforms can
# verify that the image does not run as root. The home directory is also
# readable by other users so that it works as the working directory for any
# UID. Everything outside the home directory is owned by root and read-only
# for the user.
RUN useradd --create-home --uid 1001 --gid 0 --home-dir /home/adcirc adcirc \
 && chmod -R g=u /home/adcirc \
 && chmod o+rx /home/adcirc
ENV HOME=/home/adcirc
USER 1001
WORKDIR /home/adcirc

{% for label, value in labels.items() %}
LABEL "{{ label }}"="{{ value }}"
{% endfor %}
LABEL "org.opencontainers.image.variant"="{{ flavor }}"
ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]
{% endfor %}
