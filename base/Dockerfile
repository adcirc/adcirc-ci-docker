# syntax=docker/dockerfile:1
#
# Generated by scripts/render.sh from base/spack.yaml and
# base/templates/container/Dockerfile.adcirc. Do not edit by hand.
#
# Targets:
#   devel    compilers, libraries, and build tools
#   runtime  libraries and compiler runtime libraries only
#
FROM spack/rockylinux9:1.2.2@sha256:3d91c583a3b81a4d598e4821f6248948d52e70a6fcb3ca8d8315d3cc318a1c55 AS builder

# Optional OCI registry used as a Spack binary cache, e.g.
# oci://ghcr.io/adcirc/spack-buildcache. Packages are pulled from it when
# set, and pushed to it when the buildcache_token secret is also provided.
ARG SPACK_BUILDCACHE=""

# What we want to install and how we want to install it
# is specified in a manifest file (spack.yaml)
RUN mkdir -p /opt/spack-environment && \
set -o noclobber \
&&  (echo spack: \
&&   echo '  definitions:' \
&&   echo '  # Model dependencies without Fortran code' \
&&   echo '  - c_stack:' \
&&   echo '    - netcdf-c ^hdf5~mpi' \
&&   echo '    - libjpeg-turbo' \
&&   echo '  # Model dependencies with Fortran code' \
&&   echo '  - fortran_stack:' \
&&   echo '    - netcdf-fortran' \
&&   echo '    - adcirc.xdmf3+fortran~mpi' \
&&   echo '    - openmpi+internal-hwloc+internal-pmix+internal-libevent fabrics=none' \
&&   echo '' \
&&   echo '  - when: arch.satisfies("target=x86_64:")' \
&&   echo '    compilers: [intel-oneapi-compilers@2026.0.0]' \
&&   echo '  - when: arch.satisfies("target=x86_64:")' \
&&   echo '    c_toolchain: ['"'"'%adcirc_oneapi'"'"']' \
&&   echo '  - when: arch.satisfies("target=x86_64:")' \
&&   echo '    fortran_toolchain: ['"'"'%adcirc_oneapi fflags="-heap-arrays 8192"'"'"']' \
&&   echo '' \
&&   echo '  - when: arch.satisfies("target=aarch64:")' \
&&   echo '    compilers: [gcc@16.1.0 +piclibs ~bootstrap]' \
&&   echo '  - when: arch.satisfies("target=aarch64:")' \
&&   echo '    c_toolchain: ['"'"'%adcirc_gcc'"'"']' \
&&   echo '  - when: arch.satisfies("target=aarch64:")' \
&&   echo '    fortran_toolchain: ['"'"'%adcirc_gcc'"'"']' \
&&   echo '' \
&&   echo '  specs:' \
&&   echo '  # Compilers are concretized and installed first so the model dependencies' \
&&   echo '  # can be built with them' \
&&   echo '  - group: compiler' \
&&   echo '    specs:' \
&&   echo '    - $compilers' \
&&   echo '  - group: apps' \
&&   echo '    needs: [compiler]' \
&&   echo '    specs:' \
&&   echo '    - cmake' \
&&   echo '    - ninja' \
&&   echo '    - matrix:' \
&&   echo '      - [$c_stack]' \
&&   echo '      - [$c_toolchain]' \
&&   echo '    - matrix:' \
&&   echo '      - [$fortran_stack]' \
&&   echo '      - [$fortran_toolchain]' \
&&   echo '' \
&&   echo '  toolchains:' \
&&   echo '    adcirc_oneapi:' \
&&   echo '    - spec: '"'"'%c=intel-oneapi-compilers@2026.0.0'"'"'' \
&&   echo '      when: '"'"'%c'"'"'' \
&&   echo '    - spec: '"'"'%cxx=intel-oneapi-compilers@2026.0.0'"'"'' \
&&   echo '      when: '"'"'%cxx'"'"'' \
&&   echo '    - spec: '"'"'%fortran=intel-oneapi-compilers@2026.0.0'"'"'' \
&&   echo '      when: '"'"'%fortran'"'"'' \
&&   echo '    adcirc_gcc:' \
&&   echo '    - spec: '"'"'%c=gcc@16.1.0'"'"'' \
&&   echo '      when: '"'"'%c'"'"'' \
&&   echo '    - spec: '"'"'%cxx=gcc@16.1.0'"'"'' \
&&   echo '      when: '"'"'%cxx'"'"'' \
&&   echo '    - spec: '"'"'%fortran=gcc@16.1.0'"'"'' \
&&   echo '      when: '"'"'%fortran'"'"'' \
&&   echo '' \
&&   echo '  packages:' \
&&   echo '    all:' \
&&   echo '      # Build for a fixed CPU level rather than the build runner'"'"'s CPU. This is' \
&&   echo '      # a preference rather than a requirement so that the system compiler,' \
&&   echo '      # which Spack detects at the host'"'"'s level, stays usable.' \
&&   echo '      target: [x86_64_v3, aarch64]' \
&&   echo '    # GCC 15 defaults to C23, where bool is a keyword; c-blosc 1.21.6 still' \
&&   echo '    # defines its own bool type' \
&&   echo '    c-blosc:' \
&&   echo '      require:' \
&&   echo '      - spec: cflags="-std=gnu17"' \
&&   echo '        when: '"'"'%c=gcc@15:'"'"'' \
&&   echo '' \
&&   echo '  concretizer:' \
&&   echo '    unify: true' \
&&   echo '    targets:' \
&&   echo '      # Allow the fixed target even when the build host reports a lower level' \
&&   echo '      host_compatible: false' \
&&   echo '' \
&&   echo '  # Listed in priority order: adcirc overrides packages in builtin (xdmf3)' \
&&   echo '  repos:' \
&&   echo '    adcirc:' \
&&   echo '      git: https://github.com/adcirc/adcirc-spack.git' \
&&   echo '      commit: 06ba6bbe6fa4782d507a3769b0131b99098f9deb  # main' \
&&   echo '    builtin:' \
&&   echo '      git: https://github.com/spack/spack-packages.git' \
&&   echo '      commit: d4f7c711a6a42f1c4d551c8fd10fce9a11340a81  # releases/v2026.06' \
&&   echo '' \
&&   echo '  config:' \
&&   echo '    template_dirs:' \
&&   echo '    - templates' \
&&   echo '' \
&&   echo '    install_tree:' \
&&   echo '      root: /opt/software' \
&&   echo '  view: /opt/views/view') > /opt/spack-environment/spack.yaml

RUN --mount=type=secret,id=buildcache_user,env=SPACK_BUILDCACHE_USER \
    --mount=type=secret,id=buildcache_token,env=SPACK_BUILDCACHE_TOKEN \
    cd /opt/spack-environment && spack env activate . && \
    if [ -n "${SPACK_BUILDCACHE}" ]; then \
      if [ -n "${SPACK_BUILDCACHE_TOKEN:-}" ]; then \
        spack mirror add --unsigned \
          --oci-username-variable SPACK_BUILDCACHE_USER \
          --oci-password-variable SPACK_BUILDCACHE_TOKEN \
          adcirc-buildcache "${SPACK_BUILDCACHE}"; \
      else \
        spack mirror add --unsigned adcirc-buildcache "${SPACK_BUILDCACHE}"; \
      fi; \
    fi && \
    spack install --fail-fast && \
    if [ -n "${SPACK_BUILDCACHE}" ] && [ -n "${SPACK_BUILDCACHE_TOKEN:-}" ]; then \
      spack buildcache push --update-index adcirc-buildcache; \
    fi && \
    if [ -n "${SPACK_BUILDCACHE}" ]; then spack mirror remove adcirc-buildcache; fi && \
    spack gc -y

# Strip the libraries and executables, except the compilers themselves
RUN find -L /opt/views/view/* -type f -exec readlink -f '{}' \; | \
    sort -u | \
    grep -v -e '/intel-oneapi-compilers-' -e '/gcc-[0-9]' | \
    xargs file -i | \
    grep 'charset=binary' | \
    grep 'x-executable\|x-pie-executable\|x-archive\|x-sharedlib' | \
    awk -F: '{print $1}' | xargs -r strip

# Stable locations for the pieces the final images reference directly:
#   /opt/views/oneapi                     oneAPI compiler bin/lib (x86_64 only)
#   /opt/spack-environment/compiler-runtime.conf  ld.so.conf entry for the
#                                         compiler runtime libraries, so that
#                                         programs built outside of Spack run
#                                         without LD_LIBRARY_PATH
# More than one version of a runtime can be installed (e.g. the one for the
# system compiler that built GCC), so list them all, newest first, so that
# the newest libstdc++/libgfortran take precedence
RUN cd /opt/spack-environment && spack env activate . && \
    spack find --format '{version} {prefix}' intel-oneapi-runtime gcc-runtime 2>/dev/null | \
      sort -V -r | awk '{print $2 "/lib"}' > compiler-runtime.conf && \
    test -s compiler-runtime.conf && cat compiler-runtime.conf && \
    if spack find intel-oneapi-compilers > /dev/null 2>&1; then \
      ln -s "$(spack location -i intel-oneapi-compilers)/compiler/latest" /opt/views/oneapi; \
    fi && \
    spack env activate --sh -d . > activate.sh

# Remove the compilers, and anything only they needed, for the runtime image
FROM builder AS runtime-builder
RUN cd /opt/spack-environment && \
    spack -e . find --format '{prefix} /{hash}' intel-oneapi-compilers gcc 2>/dev/null | \
      awk '$1 ~ "^/opt/software/" {print $2}' | \
      xargs -r spack -e . uninstall -y -f && \
    spack -e . gc -y && \
    spack -e . env view regenerate && \
    rm -f /opt/views/oneapi && \
    spack -e . env activate --sh -d . > activate.sh

FROM rockylinux/rockylinux:9.8@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f AS runtime

COPY --from=runtime-builder /opt/spack-environment /opt/spack-environment
COPY --from=runtime-builder /opt/software /opt/software
COPY --from=runtime-builder /opt/views /opt/views

# The entrypoint also gives users without a writable home directory (for
# example `docker run --user $(id -u):$(id -g)`) a temporary one
RUN { \
      echo '#!/bin/sh' \
      && echo '.' /opt/spack-environment/activate.sh \
      && echo 'if [ ! -w "${HOME:-/}" ]; then' \
      && echo '  HOME="${TMPDIR:-/tmp}/home-$(id -u)"; export HOME; mkdir -p "${HOME}"' \
      && echo 'fi' \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh \
&& ln -s /opt/views/view /opt/view \
&& ln -s /opt/spack-environment/compiler-runtime.conf /etc/ld.so.conf.d/spack-compiler-runtime.conf \
&& ldconfig

RUN yum install -y diffutils file gdb nano procps-ng unzip vim-enhanced which xz zip \
 && rm -rf /var/cache/yum  && yum clean all

# Mirror activate.sh so that commands which bypass the entrypoint
# (e.g. singularity exec, docker run --entrypoint) still work
ENV PATH=/opt/views/view/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Default non-root user. The primary group is 0 and the home directory is
# group-writable so the image also works when a platform (e.g. OpenShift)
# assigns an arbitrary UID with GID 0. USER is numeric so that platforms can
# verify that the image does not run as root. The home directory is also
# readable by other users so that it works as the working directory for any
# UID. Everything outside the home directory is owned by root and read-only
# for the user.
RUN useradd --create-home --uid 1001 --gid 0 --home-dir /home/adcirc adcirc \
 && chmod -R g=u /home/adcirc \
 && chmod o+rx /home/adcirc
ENV HOME=/home/adcirc
USER 1001
WORKDIR /home/adcirc

LABEL "org.opencontainers.image.title"="ADCIRC base"
LABEL "org.opencontainers.image.description"="Compilers and libraries used to build and run ADCIRC"
LABEL "org.opencontainers.image.authors"="Zach Cobell <zcobell@gmail.com>"
LABEL "org.opencontainers.image.source"="https://github.com/adcirc/adcirc-ci-docker"
LABEL "org.opencontainers.image.variant"="runtime"
ENTRYPOINT [ "/entrypoint.sh" ]
CMD [ "/bin/bash" ]

FROM rockylinux/rockylinux:9.8@sha256:8101994123cf3d0a8fee517bee7f39e555c7d92bd2d9eb3303cc988a0eeed00f AS devel

COPY --from=builder /opt/spack-environment /opt/spack-environment
COPY --from=builder /opt/software /opt/software
COPY --from=builder /opt/views /opt/views

# The entrypoint also gives users without a writable home directory (for
# example `docker run --user $(id -u):$(id -g)`) a temporary one
RUN { \
      echo '#!/bin/sh' \
      && echo '.' /opt/spack-environment/activate.sh \
      && echo 'if [ ! -w "${HOME:-/}" ]; then' \
      && echo '  HOME="${TMPDIR:-/tmp}/home-$(id -u)"; export HOME; mkdir -p "${HOME}"' \
      && echo 'fi' \
      && echo 'exec "$@"'; \
    } > /entrypoint.sh \
&& chmod a+x /entrypoint.sh \
&& ln -s /opt/views/view /opt/view \
&& ln -s /opt/spack-environment/compiler-runtime.conf /etc/ld.so.conf.d/spack-compiler-runtime.conf \
&& ldconfig

RUN yum install -y diffutils file gdb nano procps-ng unzip vim-enhanced which xz zip gcc gcc-c++ git git-lfs make \
 && rm -rf /var/cache/yum  && yum clean all

# Mirror activate.sh so that commands which bypass the entrypoint
# (e.g. singularity exec, docker run --entrypoint) still work
ENV PATH=/opt/views/view/bin:/opt/views/oneapi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Library locations used by ADCIRC's CMake and CI build commands
ENV NETCDFHOME=/opt/views/view \
    NETCDF_FORTRAN_HOME=/opt/views/view \
    HDF5HOME=/opt/views/view \
    HDF5_ROOT=/opt/views/view \
    XDMFHOME=/opt/views/view

# Default non-root user. The primary group is 0 and the home directory is
# group-writable so the image also works when a platform (e.g. OpenShift)
# assigns an arbitrary UID with GID 0. USER is numeric so that platforms can
# verify that the image does not run as root. The home directory is also
# readable by other users so that it works as the working directory for any
# UID. Everything outside the home directory is owned by root and read-only
# for the user.
RUN useradd --create-home --uid 1001 --gid 0 --home-dir /home/adcirc adcirc \
 && chmod -R g=u /home/adcirc \
 && chmod o+rx /home/adcirc
ENV HOME=/home/adcirc
USER 1001
